  }
  const j0=Math.floor((90-f.la)/STEP),i0=Math.floor((f.lo+180)/STEP);let mn=1e9,mx=-1e9,sm0=0,n=0,sl=0;
  for(let dj=-fp.hh;dj<=fp.hh;dj++){
