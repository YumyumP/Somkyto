function shade(){
  hs=hs||document.createElement('canvas');hs.width=GW;hs.height=GH;
  const x=hs.getContext('2d'),im=x.createImageData(GW,GH),d=im.data,ca=Math.cos(35*rad),sa=Math.sin(35*rad),lx=-.7071*ca,ly=.7071*ca;
  for(let j=0;j<GH;j++){
    const lat=90-(j+.5)*STEP,dx=2*KM*STEP*Math.max(.25,Math.cos(lat*rad)),dy=2*KM*STEP;
    for(let i=0;i<GW;i++){
      const k=j*GW+i,e=E[k];
      const zx=(E[j*GW+Math.min(i+1,GW-1)]-E[j*GW+Math.max(i-1,0)])/dx*9,zy=-(E[Math.min(j+1,GH-1)*GW+i]-E[Math.max(j-1,0)*GW+i])/dy*9;
      const nn=Math.hypot(zx,zy,1),sh=Math.max(0,(-zx*lx-zy*ly+sa)/nn),b=cl(.52+1.48*(sh-sa),.16,1.32);

      // Coloración hipsométrica y de albedo marciano (tonos basálticos, ocre-óxido y cumbres volcánicas)
      const t=cl((e+6.5)/16,0,1),hi=cl((e-7)/14,0,1);
      const dk=real?0:.22*M[k];
      let R=(116+86*t+28*hi)*(1-dk),G=(58+54*t+46*hi)*(1-dk),B=(40+32*t+48*hi)*(1-dk);

      // Hielo en casquetes polares extremos
      const pol=sm(cl((Math.abs(lat)-81)/8,0,1));
      if(pol>0){R=R*(1-pol)+228*pol;G=G*(1-pol)+224*pol;B=B*(1-pol)+230*pol}

      const o=k*4;
      d[o]=cl(R*b,0,255);
      d[o+1]=cl(G*b,0,255);
      d[o+2]=cl(B*b,0,255);
      d[o+3]=255;
    }
  }
  x.putImageData(im,0,0);
}

function contours(){
  cont=[];let mn=1e9,mx=-1e9;for(const v of E){if(v<mn)mn=v;if(v>mx)mx=v}
  const T4=[[],[3,0],[0,1],[3,1],[1,2],[3,0,1,2],[0,2],[3,2],[2,3],[0,2],[0,1,2,3],[2,1],[3,1],[0,1],[3,0],[]];
  // Intervalo de 2 km (curvas maestras cada 6 km) para abarcar los ~29 km de desnivel marciano
  for(let L=Math.ceil(mn/2)*2;L<=mx;L+=2){
    const p=new Path2D();
    for(let j=0;j<GH-1;j++)for(let i=0;i<GW-1;i++){
      const a=E[j*GW+i],b=E[j*GW+i+1],c=E[(j+1)*GW+i+1],d=E[(j+1)*GW+i],m=(a>L?1:0)|(b>L?2:0)|(c>L?4:0)|(d>L?8:0);
      if(m===0||m===15)continue;
      const P=e=>e===0?[i+(L-a)/(b-a),j]:e===1?[i+1,j+(L-b)/(c-b)]:e===2?[i+(L-d)/(c-d),j+1]:[i,j+(L-a)/(d-a)],t=T4[m];
      for(let q=0;q<t.length;q+=2){const u=P(t[q]),v=P(t[q+1]);p.moveTo((u[0]+.5)*S,(u[1]+.5)*S);p.lineTo((v[0]+.5)*S,(v[1]+.5)*S)}
    }
    cont.push({p,idx:L%6===0});
  }
}

