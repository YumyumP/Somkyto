<body>
<h1>Mapa marciano · proyección equirrectangular</h1>
<p>Superficie completa de Marte, longitudes areográficas (E positivo). Desliza el mapa horizontalmente en pantallas pequeñas.</p>
<div class="bar">
<label><input type="checkbox" id="lr" checked> Foto / relieve</label>
<label><input type="checkbox" id="lc" checked> Curvas de nivel</label>
<label><input type="checkbox" id="lg" checked> Cuadrícula</label>
<label><input type="checkbox" id="lm" checked> Llanuras y cuencas</label>
<label><input type="checkbox" id="lk" checked> Cráteres y volcanes</label>
<label><input type="checkbox" id="ls" checked> ★ Misiones</label>
<label>Terreno <select id="sel"><option value="">Elige uno…</option></select></label>
<label>Foto global Viking/MDIM (JPG/PNG) <input type="file" id="pho" accept="image/*"></label>
<label>DEM MOLA (PNG/JPG 8 bits) <input type="file" id="dem" accept="image/*"></label>
<button type="button" id="syn">Volver al modelo sintético</button>
<button type="button" id="tour">▶ Tour de misiones</button>
</div>
<div id="st" role="status" aria-live="polite">Calculando relieve marciano…</div>
<div class="map"><div id="wrap"><canvas id="c" width="2880" height="1440" role="img" aria-label="Mapa plano de Marte con llanuras, cuencas, volcanes, cráteres, cuadrícula y curvas de nivel"></canvas><canvas id="ov" width="2880" height="1440" aria-hidden="true"></canvas></div></div><div id="tip"></div>
<div id="ro" aria-live="polite">Pasa el cursor sobre una llanura, cuenca, volcán, cráter o ★ misión para resaltarlo; haz clic (o elígelo en la lista) para ver su ficha, datos del terreno e imágenes reales.</div>

<section id="pn" hidden>
<h2 id="pe"></h2><p id="pl"></p>
<dl id="pd"></dl>

<!-- 1. PERFIL TOPOGRÁFICO (Ubicado en la parte superior) -->
<h3>Perfil topográfico</h3>
<canvas id="pf" width="640" height="220" role="img" aria-label="Perfil de elevación oeste-este y sur-norte del terreno marciano seleccionado"></canvas>

<p id="pf2"></p><p id="pw" class="note"></p>

<!-- 2. FOTO ESTÁTICA DE MARTE (Ubicada debajo del perfil) -->
<div class="static-moon-card">
    <img id="moon-view-img" src="https://upload.wikimedia.org/wikipedia/commons/0/02/OSIRIS_Mars_true_color.jpg" onerror="this.src='https://placehold.co/600x220/2a120a/f97316?text=Marte+(OSIRIS+True+Color)'" alt="Foto estática de Marte" />
    <div class="static-moon-footer">
        <span style="color:#fb923c; font-weight:600;">FOTO ESTÁTICA MARCIANA</span>
        <span>TEMP. MEDIA -63 °C</span>
    </div>
</div>

<h3>Imágenes reales</h3>
<div id="gl"></div><p id="gs" class="note"></p>
<h3>Recorte de tu mosaico Viking / MDIM</h3>
<canvas id="ph" width="520" height="520" role="img" aria-label="Recorte del mosaico global sobre el terreno seleccionado"></canvas>
<p id="pn0" class="note">Carga un mosaico global con el botón “Foto global Viking/MDIM” para ver aquí un recorte real de este terreno.</p>

<!-- Botón de Sincronización -->
<button type="button" class="sync-bridge-btn" onclick="enviarSeleccionTerreno()">
    🚀 Abrir Simulador Topográfico Detallado
</button>

<p id="lnk" class="note"></p>
</section>

<p class="note">Qué es real y qué no: nombres, coordenadas, alturas y diámetros provienen de catálogos de la UAI/USGS y son aproximados, y las formas de las llanuras y cuencas están simplificadas. Mientras no cargues datos externos, el relieve, las curvas de nivel, las elevaciones y los perfiles provienen de un modelo sintético que reproduce la dicotomía cortical marciana, Tharsis, Valles Marineris, los grandes volcanes y las cuencas de impacto. Para usar datos reales descarga del USGS Astrogeology / NASA Mars Global Surveyor el mosaico global Viking MDIM 2.1 y el modelo de elevación MOLA MEGDR, conviértelos a JPG/PNG (la elevación en escala de grises de 8 bits, de −8,2 a +21,2 km respecto al areoide) y cárgalos con los botones superiores. Las imágenes de cada ficha se consultan en Wikipedia (NASA/ESA y otras fuentes) cuando hay conexión.</p>

<script>
(()=>{
// Constantes cartográficas y físicas de Marte (R = 3389,5 km; 1° ecuatorial ≈ 59,16 km)
const W=2880,H=1440,PPD=W/360,KM=59.16,STEP=.4,GW=900,GH=450,S=W/GW,RM=3389.5,rad=Math.PI/180;
const cv=document.getElementById('c'),g=cv.getContext('2d'),ro=document.getElementById('ro'),st=document.getElementById('st');
const X=o=>(o+180)*PPD,Y=a=>(90-a)*PPD,cl=(v,a,b)=>Math.max(a,Math.min(b,v)),sm=t=>t*t*(3-2*t);

// Llanuras (Planitiae), Cuencas y Mesetas (Plana)
const MARIA=[
  ['Vastitas Borealis','Llanura Boreal',67.5,180,3000,1200,9000,'La mayor llanura de tierras bajas de Marte; rodea toda la región polar norte unos 4 a 5 km por debajo del datum medio. La sonda Phoenix aterrizó aquí en 2008.'],
  ['Utopia Planitia','Llanura de Utopía',46.7,117.5,1650,1650,3300,'La mayor cuenca de impacto reconocida en Marte y en el sistema solar. Lugar de aterrizaje de Viking 2 (1976) y del rover Zhurong (2021).'],
  ['Acidalia Planitia','Llanura de Acidalia',49.8,-20.7,1500,1500,3000,'Extensa llanura oscura del hemisferio norte, al norte de los canales de desagüe de Chryse Planitia.'],
  ['Amazonis Planitia','Llanura de Amazonis',24.8,-164.0,1400,1400,2800,'Una de las llanuras más lisas y jóvenes de Marte, cubierta por lavas y sedimentos del período Amazónico.'],
  ['Chryse Planitia','Llanura de Chryse',28.4,-39.7,800,800,1600,'Cuenca circular donde desembocan enormes canales de inundación antiguos (Kasei, Maja y Ares Vallis). Sitio de Viking 1 y Mars Pathfinder.'],
  ['Isidis Planitia','Llanura de Isidis',12.9,87.0,600,600,1200,'Gran cuenca de impacto al este de Syrtis Major; el cráter Jezero y el rover Perseverance se ubican en su borde occidental.'],
  ['Elysium Planitia','Llanura de Elysium',3.0,154.7,1500,1200,3000,'Amplia llanura ecuatorial de vulcanismo reciente al sur del domo de Elysium. La estación geofísica InSight aterrizó en su sector occidental.'],
  ['Hellas Planitia','Cuenca de Hellas',-42.4,70.5,1150,900,2300,'La cuenca de impacto visible más profunda de Marte (hasta −8,2 km respecto al datum), con frecuentes tormentas de polvo y brumas.'],
  ['Argyre Planitia','Cuenca de Argyre',-49.7,-43.4,650,650,1300,'Gran cuenca de impacto bien conservada en las tierras altas del sur, rodeada por los macizos de Charitum y Nereidum Montes.'],
  ['Syrtis Major Planum','Meseta de Syrtis Major',8.4,69.5,650,600,1300,'Volcán en escudo de bajo relieve y color muy oscuro por su basalto expuesto libre de polvo; fue el primer rasgo superficial documentado desde la Tierra por Huygens en 1659.'],
  ['Meridiani Planum','Llanura de Meridiani',-0.2,-2.5,550,500,1100,'Llanura ecuatorial rica en hematita gris cristalina y sulfatos; explorada por el rover Opportunity durante casi 15 años.'],
  ['Solis Planum','Meseta del Sol',-26.4,-90.0,900,800,1800,'Meseta volcánica elevada al sur de Valles Marineris, célebre por sus intensas tormentas de polvo regionales.'],
  ['Hesperia Planum','Meseta de Hesperia',-22.3,110.0,800,750,1600,'Extensa meseta de lavas fisurales con crestas de compresión al noreste de Hellas; define el período Hespérico de la geología marciana.'],
  ['Arcadia Planitia','Llanura de Arcadia',47.2,-175.7,1100,1000,2200,'Llanura septentrional al noroeste de Tharsis con flujos volcánicos jóvenes e indicios de abundante hielo subsuperficial.']
];

const MR=MARIA.map((m,i)=>({n:m[0],es:m[1],u:m[1].toUpperCase(),a:m[2],o:m[3],ew:m[4],rx:m[4]/(KM*Math.max(.25,Math.cos(m[2]*rad))),ry:m[5]/KM,s:(i+1)*1.3,D:m[6],f:m[7]}));

// Volcanes ('v'), Cráteres ('r','l','t','b') y Cráteres polares ('p')
const CR=[
  ['Monte Olimpo',18.65,-133.8,624,'v','El mayor volcán del sistema solar, con unos 21,9 km de altura sobre el datum marciano y una caldera sumital de 80 km de ancho.',21.2,'Olympus Mons'],
  ['Ascraeus Mons',11.9,-104.5,456,'v','El más septentrional y alto de los tres grandes volcanes alineados de Tharsis Montes, alcanzando más de 18 km de altitud.',18.1,'Ascraeus Mons'],
  ['Pavonis Mons',1.48,-112.96,375,'v','Volcán en escudo central de la cadena Tharsis Montes, situado casi exactamente sobre el ecuador marciano.',14.0,'Pavonis Mons'],
  ['Arsia Mons',-8.4,-120.09,435,'v','Volcán meridional de Tharsis Montes, coronado por una gigantesca caldera colapsada de 110 km de diámetro.',17.7,'Arsia Mons'],
  ['Elysium Mons',25.02,147.21,410,'v','Volcán principal de la provincia volcánica de Elysium, que se eleva unos 14 km sobre las llanuras circundantes.',14.1,'Elysium Mons'],
  ['Alba Mons',40.5,-109.9,1015,'v','Inmenso volcán de pendientes muy suaves y extenso sistema de fosas tectónicas al norte del abultamiento de Tharsis.',6.8,'Alba Mons'],
  ['Jezero',18.38,77.58,45,'r','Antiguo cráter lacustre con un delta fluvial muy bien conservado; sitio de aterrizaje del rover Perseverance y el helicóptero Ingenuity.',0,'Jezero (crater)'],
  ['Gale',-5.4,137.8,154,'r','Cráter con un gran monte central estratificado de 5,5 km de altura (Aeolis Mons / Monte Sharp), explorado por el rover Curiosity.',0,'Gale (crater)'],
  ['Gusev',-14.5,175.4,166,'l','Antiguo cráter lacustre conectado al gran canal Ma’adim Vallis; explorado por el rover Spirit a partir de 2004.',0,'Gusev (crater)'],
  ['Schiaparelli',-2.7,16.7,459,'r','Gran cuenca de impacto cerca del ecuador, al este de Meridiani Planum, rellena de capas sedimentarias y dunas.',0,'Schiaparelli (Martian crater)'],
  ['Huygens',-13.9,55.6,467,'r','Uno de los mayores cráteres de impacto de las tierras altas del sur, con anillo interior bien preservado y carbonatos expuestos.',0,'Huygens (crater)'],
  ['Cassini',23.8,32.1,408,'r','Gran cráter antiguo en Arabia Terra cuyo borde ha sido intensamente erosionado por antiguos procesos fluviales.',0,'Cassini (Martian crater)'],
  ['Holden',-26.0,-34.0,153,'l','Cráter con abanicos aluviales y megabrechas lacustres atravesado por el sistema fluvial de Uzboi Vallis.',0,'Holden (Martian crater)'],
  ['Korolev',72.8,164.5,82,'p','Cráter cercano al polo norte relleno permanentemente por un domo de hielo de agua de 1,8 km de espesor durante todo el año.',0,'Korolev (Martian crater)'],
  ['Herschel',-14.9,129.7,298,'r','Gran cuenca de impacto del período Noéico en Terra Cimmeria con campos de dunas oscuras en su piso.',0,'Herschel (Martian crater)'],
  ['Lowell',-52.3,-81.4,203,'r','Cráter de impacto con un nítido anillo de picos concéntrico en la región austral de Aonia Terra.',0,'Lowell (Martian crater)']
];

const E=new Float32Array(GW*GH),M=new Float32Array(GW*GH);let real=false,hs=null,cont=[],photo=null,sel=null;

function rng(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
const hsh=(x,y)=>{let h=Math.imul(x,374761393)^Math.imul(y,668265263);h=Math.imul(h^(h>>>13),1274126177);return((h^(h>>>16))>>>0)/4294967295};
function vn(x,y,w){const xi=Math.floor(x),yi=Math.floor(y),fx=sm(x-xi),fy=sm(y-yi),x0=((xi%w)+w)%w,x1=(x0+1)%w,a=hsh(x0,yi),b=hsh(x1,yi),c=hsh(x0,yi+1),d=hsh(x1,yi+1);return a+(b-a)*fx+(c-a)*fy+(a-b-c+d)*fx*fy}
function fbm(lon,lat){let s=0,amp=.5,f=1;for(let o=0;o<5;o++){s+=amp*vn((lon+180)/22.5*f,(lat+90)/22.5*f+o*17,16*f);amp*=.5;f*=2}return s}

function mask(lon,lat){
  let m=0;
  for(const q of MR){
    const dl=((lon-q.o+540)%360)-180,da=lat-q.a;
    if(Math.abs(da)>q.ry*1.5||Math.abs(dl)>q.rx*1.5)continue;
    const u=dl/q.rx,v=da/q.ry,an=Math.atan2(v,u),f=1+.18*(.5*Math.sin(2*an+q.s)+.3*Math.sin(3*an+q.s*1.7)+.2*Math.sin(5*an+q.s*2.3)),d=Math.hypot(u,v);
    m=Math.max(m,cl((f-d)/(.15*f),0,1));
  }
  return m;
}

function dist(a,b,c,d){const p=a*rad,q=c*rad;return RM*Math.acos(cl(Math.sin(p)*Math.sin(q)+Math.cos(p)*Math.cos(q)*Math.cos((b-d)*rad),-1,1))}

// Cráter de impacto sintético
function bowl(la,lo,D,dpOverride){
  const R=D/2,dp=dpOverride||Math.min(4.2,.05*Math.pow(D,.82)),cs=Math.max(.12,Math.cos(la*rad)),hw=Math.min(GW/2,Math.ceil(R*1.4/(KM*cs)/STEP)),hh=Math.ceil(R*1.4/KM/STEP),j0=Math.floor((90-la)/STEP),i0=Math.floor((lo+180)/STEP);
  for(let dj=-hh;dj<=hh;dj++){
    const j=j0+dj;if(j<0||j>=GH)continue;const lat=90-(j+.5)*STEP;
    for(let di=-hw;di<=hw;di++){
      const i=((i0+di)%GW+GW)%GW,lon=-180+(i+.5)*STEP,u=dist(lat,lon,la,lo)/R;if(u>1.4)continue;
      let v=u<1?-dp*(1-u*u):0;
      v+=.28*dp*Math.exp(-(((u-1.03)/.13)**2));
      if(D>80&&D<500)v+=.2*dp*Math.exp(-((u/.11)**2));
      E[j*GW+i]+=v;
    }
  }
}

// Volcán en escudo marciano con caldera sumital
function cone(la,lo,D,peakH){
  const R=D/2,cs=Math.max(.12,Math.cos(la*rad)),hw=Math.min(GW/2,Math.ceil(R*1.5/(KM*cs)/STEP)),hh=Math.ceil(R*1.5/KM/STEP),j0=Math.floor((90-la)/STEP),i0=Math.floor((lo+180)/STEP);
  for(let dj=-hh;dj<=hh;dj++){
    const j=j0+dj;if(j<0||j>=GH)continue;const lat=90-(j+.5)*STEP;
    for(let di=-hw;di<=hw;di++){
      const i=((i0+di)%GW+GW)%GW,lon=-180+(i+.5)*STEP,u=dist(lat,lon,la,lo)/R;if(u>1.45)continue;
      const base=E[j*GW+i],dh=Math.max(2,peakH-base);
      let v=u<1.35?dh*Math.exp(-2.1*u*u)*(1-.15*u):0;
      if(u<.16)v-=dh*.14*(1-(u/.16)**2); // Caldera central
      E[j*GW+i]+=v;
    }
  }
}

function synth(){
  real=false;
  for(let j=0;j<GH;j++){
    const lat=90-(j+.5)*STEP;
    for(let i=0;i<GW;i++){
      const lon=-180+(i+.5)*STEP,k=j*GW+i;
      // Dicotomía global marciana: tierras bajas al norte (-4.2 km) y tierras altas al sur (+2.2 km)
      const dicLat=12-22*Math.cos((lon-35)*rad)-8*Math.sin(2*(lon+20)*rad);
      const dic=sm(cl((lat-dicLat+22)/44,0,1));
      let e=(1-dic)*2.1 + dic*(-4.1) + (fbm(lon,lat)-.48)*2.6;

      // Abultamiento de Tharsis
      const dTh=dist(lat,lon,-2,-112)/2800;
      if(dTh<1.4) e+=5.2*Math.exp(-1.8*dTh*dTh);

      // Levantamiento volcánico de Elysium
      const dEl=dist(lat,lon,23,148)/1400;
      if(dEl<1.3) e+=3.1*Math.exp(-2.1*dEl*dEl);

      // Meseta de Syrtis Major
      const dSy=dist(lat,lon,8.4,69.5)/750;
      if(dSy<1.2) e+=1.6*Math.exp(-2.0*dSy*dSy);

      // Valles Marineris (sistema de cañones tectónicos de 4000 km)
      if(lon>-98&&lon<-32&&lat>-24&&lat<2){
        const axisLat=-12.5+2.8*Math.sin((lon+65)*3.2*rad)-1.5*((lon+65)/30);
        const wLat=2.6+1.4*Math.exp(-(((lon+68)/14)**2));
        const dy=Math.abs(lat-axisLat)/wLat;
        const xEnv=sm(cl((lon+96)/8,0,1))*sm(cl((-34-lon)/8,0,1));
        if(dy<1.4) e-=6.8*xEnv*Math.exp(-1.9*dy*dy);
      }

      // Casquetes polares (Planum Boreum y Planum Australe)
      if(lat>80) e+=2.4*sm((lat-80)/10);
      if(lat<-80) e+=2.2*sm((-lat-80)/10);

      const m=mask(lon,lat);
      M[k]=m;
      E[k]=e;
    }
  }
  // Grandes cuencas de impacto profundas
  bowl(-42.4,70.5,2200,8.4);   // Hellas Planitia
  bowl(-49.7,-43.4,1300,5.6);  // Argyre Planitia
  bowl(12.9,87.0,1150,3.4);    // Isidis Planitia
  bowl(46.7,117.5,3200,2.2);   // Utopia Planitia
  bowl(28.4,-39.7,1500,2.0);   // Chryse Planitia

  // Volcanes y cráteres del catálogo
  CR.forEach(c=>{
    if(c[4]==='v') cone(c[1],c[2],c[3],c[6]);
    else bowl(c[1],c[2],c[3]);
  });
  // Domo polar de hielo en Korolev
  cone(72.8,164.5,68,-2.2);

  // Cráteres de fondo (más abundantes en las tierras altas del sur)
  const r=rng(42);
  for(let n=0;n<480;n++){
    const u=r(),la=Math.asin(2*Math.pow(u,1.35)-1)/rad,lo=r()*360-180;
