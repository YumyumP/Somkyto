  const at=(dx,dy)=>{const la=cl(f.la+dy/KM,-89.8,89.8),lo=f.lo+dx/(KM*cs),i=((Math.floor((lo+180)/STEP)%GW)+GW)%GW,j=cl(Math.floor((90-la)/STEP),0,GH-1);return E[j*GW+i]};
  const A=[],B=[];let mn=1e9,mx=-1e9;
  for(let k=0;k<=N;k++){const t=-R+2*R*k/N,a=at(t,0),b=at(0,t);A.push(a);B.push(b);mn=Math.min(mn,a,b);mx=Math.max(mx,a,b)}
