      d=u*u+v*v;if(d>1)continue;d+=.5;
    }else if(f.k==='sitio'){
      if(!$('ls').checked)continue;
      const u=(px-X(f.lo))/26,v=(py-Y(f.la))/26;
      d=u*u+v*v;if(d>1)continue;d*=.05;
    }else{
      const u=(px-X(f.lo))/Math.max(14,f.D/2/(KM*csn(f))*PPD),v=(py-Y(f.la))/Math.max(14,f.D/2/KM*PPD);
      d=u*u+v*v;if(d>1.2)continue;d*=.2;
    }
    if(d<bd){bd=d;best=f}
  }
  return best;
}

cv.addEventListener('pointermove',e=>{
  const f=hit(e);hov=f;cv.style.cursor=f?'pointer':'default';
  if(f){
    tip.style.display='block';
    tip.textContent=(f.k==='sitio'?'★ ':f.k==='volcan'?'▲ ':'')+f.es+' · '+TIPO[f.k].split(' (')[0];
    tip.style.left=e.clientX+14+'px';tip.style.top=e.clientY+14+'px';
  }else tip.style.display='none';
});
cv.addEventListener('pointerleave',()=>{hov=null;tip.style.display='none'});
cv.addEventListener('click',e=>{stopTour();const b=hit(e);if(b){sl0.value=FT.indexOf(b);show(b)}});

function ring(f,col,w,k,fill){
  const x=X(f.lo),y=Y(f.la);let rx,ry;
  if(f.k==='mar'){rx=f.rx*PPD;ry=f.ry*PPD}
  else if(f.k==='sitio')rx=ry=22;
  else{rx=Math.max(14,f.D/2/(KM*csn(f))*PPD)*1.15;ry=Math.max(14,f.D/2/KM*PPD)*1.15}
  o.beginPath();o.ellipse(x,y,rx*k,ry*k,0,0,7);
  if(fill){o.fillStyle=fill;o.fill()}
  o.strokeStyle=col;o.lineWidth=w;o.stroke();
}

(function loop(t){
  const act=hov||sel;
  if(act||dirty){
    o.clearRect(0,0,W,H);dirty=!!act;
    if(hov)ring(hov,'#fff',4,1,'rgba(255,209,102,.22)');
    if(sel){const p=(t/1400)%1;ring(sel,'rgba(255,209,102,'+(1-p).toFixed(2)+')',5,1+.4*p)}
  }
  requestAnimationFrame(loop);
})(0);

const tb=$('tour');
function stopTour(){if(tid){clearInterval(tid);tid=null;tb.textContent='▶ Tour de misiones'}}
tb.addEventListener('click',()=>{
  if(tid){stopTour();return}
  const L=FT.filter(f=>f.k==='sitio');let n=0;
  const go=()=>{const f=L[n++%L.length];sl0.value=FT.indexOf(f);show(f,'tour')};
  go();tid=setInterval(go,6000);tb.textContent='■ Detener tour';
});

async function imgs(f){
  const gl=$('gl'),gs=$('gs');gl.innerHTML='';gs.textContent='Buscando imágenes reales de Marte…';
  try{
    let r=WK[f.es];
    if(!r){
      const q=f.k==='mar'||f.k==='volcan'||f.k==='canon'?f.lat+' Mars':f.k==='sitio'?f.lat+' Mars':f.lat;
      const j=await(await fetch('https://en.wikipedia.org/w/api.php?action=query&format=json&origin=*&generator=search&gsrlimit=8&prop=pageimages&piprop=thumbnail&pithumbsize=480&gsrsearch='+encodeURIComponent(q))).json();
      r=Object.values((j.query||{}).pages||{}).filter(p=>p.thumbnail).sort((a,b)=>a.index-b.index).slice(0,3);
      WK[f.es]=r;
    }
    if(sel!==f)return;
    gl.innerHTML='';
    r.forEach(p=>{
      const fg=document.createElement('figure'),a=document.createElement('a'),im=document.createElement('img'),c=document.createElement('figcaption');
      a.href='https://en.wikipedia.org/wiki/'+encodeURIComponent(p.title.replace(/ /g,'_'));
      a.target='_blank';a.rel='noopener';im.src=p.thumbnail.source;im.alt=p.title;im.loading='lazy';
      im.onerror=()=>fg.remove();c.textContent=p.title;a.append(im);fg.append(a,c);gl.append(fg);
    });
    gs.textContent=r.length?'Imágenes reales de Wikipedia (NASA/ESA y otras fuentes). Clic para abrir el artículo.':'No encontré imágenes para este lugar; usa los enlaces de abajo.';
  }catch(err){
    if(sel===f)gs.textContent='No pude cargar las imágenes (¿sin conexión?). Usa los enlaces de abajo.';
  }
}

$('pho').addEventListener('change',async e=>{
  const f=e.target.files[0];if(!f)return;
  try{photo=await createImageBitmap(f);st.textContent='Mosaico global de Marte cargado.';draw();if(sel)crop(sel)}
  catch(err){st.textContent='No pude leer esa foto. Usa JPG o PNG (los TIFF no funcionan en el navegador).'}
});

setTimeout(()=>{synth();rebuild('Mostrando relieve y curvas sintéticos de Marte.')},30);

window.enviarSeleccionTerreno = function() {
    if (!sel) {
        st.textContent = 'Por favor, selecciona primero una llanura, volcán, cráter o misión en el mapa.';
        return;
    }

    const datosTerreno = {
        id: sel.es.toLowerCase().replace(/[^a-z0-9]/g, '_'),
        nombre: sel.es,
        latitud: sel.la,
        longitud: sel.lo,
        coordenadas: sel.lat,
        diametro: sel.D || 'N/A',
        tipo: TIPO[sel.k] || 'Región marciana',
        descripcion: sel.f || '',
        similitudSugerida: 95.4,
        brechaRealidad: 'Baja (Análogo Marciano Óptimo)'
    };

    window.parent.postMessage({
        type: 'SELECTION_UPDATED',
        payload: datosTerreno
    }, '*');
    st.textContent = 'Selección enviada al simulador topográfico: ' + sel.es;
};

})();
