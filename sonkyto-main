<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Planetary Twin Matcher | NASA Space Apps 2026</title>
    
    <!-- Tailwind CSS para estilos rápidos y limpios -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Leaflet CSS & JS para mapas satelitales interactivos -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    
    <!-- Chart.js para el gráfico de radar científico -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Three.js para el Visor Topográfico 3D -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <!-- html2pdf.js para descarga directa de PDF sin ventana de impresión -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style>
        body {
            background-color: #0b0f19;
            color: #e2e8f0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        .glass-panel {
            background: rgba(17, 24, 39, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(56, 189, 248, 0.2);
        }
        #earth-map {
            height: 100%;
            min-height: 285px;
            border-radius: 0.75rem;
            z-index: 1;
        }
        /* Contenedor del visor 3D Three.js */
        #canvas-3d-container {
            width: 100%;
            height: 210px;
            border-radius: 0.75rem;
            overflow: hidden;
            position: relative;
            background: #020617;
        }
        .topo-grid {
            background-image: 
                linear-gradient(to right, rgba(56, 189, 248, 0.08) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(56, 189, 248, 0.08) 1px, transparent 1px);
            background-size: 20px 20px;
        }
        .rank-card {
            transition: all 0.2s ease-in-out;
        }
        .rank-card:hover {
            transform: translateY(-2px);
        }
        .rank-card.active {
            border-color: #38bdf8;
            background: rgba(14, 165, 233, 0.15);
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.2);
        }
        .weight-pill {
            transition: all 0.25s ease;
        }
        /* Estilo personalizado para el deslizador temporal de Enero a Diciembre */
        input[type=range].month-slider {
            -webkit-appearance: none;
            appearance: none;
            width: 100%;
            height: 8px;
            background: linear-gradient(90deg, #0284c7 0%, #10b981 50%, #6366f1 100%);
            border-radius: 999px;
            outline: none;
            cursor: pointer;
        }
        input[type=range].month-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #ffffff;
            border: 3px solid #38bdf8;
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.8);
            cursor: pointer;
            transition: transform 0.15s ease;
        }
        input[type=range].month-slider::-webkit-slider-thumb:hover {
            transform: scale(1.15);
        }
        .month-tick {
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .month-tick:hover {
            color: #38bdf8;
        }
        .month-tick.active-month {
            color: #38bdf8;
            font-weight: 800;
            text-decoration: underline;
        }
        /* Pines personalizados del Mapa Mundial según Ranking */
        .custom-map-pin {
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-weight: 800;
            border-radius: 9999px;
            color: #ffffff;
            transition: all 0.25s ease;
            white-space: nowrap;
        }
        .pin-rank-1 {
            background: linear-gradient(135deg, #10b981, #0284c7);
            border: 2px solid #ffffff;
            box-shadow: 0 0 16px rgba(16, 185, 129, 0.95), 0 0 28px rgba(56, 189, 248, 0.7);
            font-size: 11px;
            padding: 3px 8px;
            z-index: 1000 !important;
            animation: pulseWinner 2s infinite;
        }
        .pin-rank-2 {
            background: rgba(245, 158, 11, 0.92);
            border: 2px solid #fef3c7;
            box-shadow: 0 0 10px rgba(245, 158, 11, 0.6);
            font-size: 10px;
            padding: 2px 7px;
            z-index: 800 !important;
        }
        .pin-rank-3 {
            background: rgba(100, 116, 139, 0.92);
            border: 1.5px solid #e2e8f0;
            box-shadow: 0 0 8px rgba(148, 163, 184, 0.4);
            font-size: 10px;
            padding: 2px 6px;
            z-index: 700 !important;
        }
        .pin-rank-other {
            background: rgba(51, 65, 85, 0.85);
            border: 1px solid #94a3b8;
            color: #cbd5e1;
            font-size: 9px;
            padding: 1px 5px;
            z-index: 600 !important;
        }
        @keyframes pulseWinner {
            0% { transform: scale(1); }
            50% { transform: scale(1.08); }
            100% { transform: scale(1); }
        }
        /* PASO 5: estilos del informe */
        .report-sheet { background:#0f1626; border:1px solid rgba(56,189,248,.3); color:#e2e8f0; }
        .report-sheet h2 { font-size:12px; letter-spacing:.14em; text-transform:uppercase; color:#38bdf8; font-weight:800; border-bottom:1px solid #1e293b; padding-bottom:6px; margin:26px 0 10px; }
        .report-sheet p, .report-sheet li { font-size:13px; line-height:1.6; color:#cbd5e1; }
        .report-sheet table { width:100%; border-collapse:collapse; font-size:12px; }
        .report-sheet th { text-align:right; color:#94a3b8; font-weight:600; font-size:10px; text-transform:uppercase; padding:5px 8px; border-bottom:1px solid #334155; }
        .report-sheet th:first-child, .report-sheet td:first-child { text-align:left; }
        .report-sheet td { text-align:right; padding:5px 8px; border-bottom:1px solid #1e293b; font-family:ui-monospace,Menlo,monospace; }
        .report-sheet td:first-child { font-family:inherit; color:#e2e8f0; }
        .report-sheet tfoot td { font-weight:800; color:#fff; border-top:1px solid #475569; }
        .rep-head { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; }
        .rep-head div { background:#0b1220; border:1px solid #1e293b; border-radius:10px; padding:8px 10px; }
        .rep-head small { display:block; font-size:9px; letter-spacing:.12em; color:#64748b; text-transform:uppercase; }
        .rep-head b { font-size:14px; color:#fff; }
        .rep-box { background:#0b1220; border:1px solid #1e293b; border-radius:10px; padding:10px 14px; }
        .rep-bar { height:8px; border-radius:99px; background:#1e293b; overflow:hidden; }
        .rep-bar > span { display:block; height:100%; background:linear-gradient(90deg,#10b981,#38bdf8); }
        @media print {
            body > *:not(#report-overlay) { display:none !important; }
            #report-overlay { position:static !important; background:#fff !important; padding:0 !important; display:block !important; }
            .no-print { display:none !important; }
            .report-sheet { background:#fff !important; color:#0f172a !important; border:none !important; }
            .report-sheet p, .report-sheet li, .report-sheet td, .report-sheet td:first-child, .report-sheet b { color:#0f172a !important; }
            .report-sheet h2 { color:#0369a1 !important; }
            .rep-box, .rep-head div { background:#f8fafc !important; border-color:#cbd5e1 !important; }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- Navbar Superior -->
    <header class="glass-panel border-b border-slate-800 px-6 py-3.5 flex flex-wrap items-center justify-between gap-4 sticky top-0 z-50">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-sky-500 to-indigo-600 flex items-center justify-center font-bold text-white shadow-lg shadow-sky-500/20">
                PTM
            </div>
            <div>
                <h1 class="text-lg font-bold tracking-wide text-white">PLANETARY TWIN MATCHER</h1>
                <p class="text-xs text-sky-400">Motor Matemático y Estacional Sincronizado • NASA Space Apps 2026</p>
            </div>
        </div>

        <!-- Controles de Misión -->
        <div class="flex flex-wrap items-center gap-3">
            <div>
                <label class="block text-[10px] uppercase tracking-wider text-slate-400 mb-1">Objetivo Espacial</label>
                <select id="target-select" class="bg-slate-900 border border-slate-700 text-sm rounded-lg px-3 py-2 text-white focus:outline-none focus:border-sky-500">
                    <option value="shackleton">Luna: Cráter Shackleton (Polo Sur)</option>
                    <option value="marius">Luna: Colinas Marius (Tubos de Lava)</option>
                    <option value="jezero">Marte: Cráter Jezero (Delta Antiguo)</option>
                    <option value="arcadia">Marte: Arcadia Planitia (Hielo Subsuperficial)</option>
                </select>
            </div>

            <div>
                <label class="block text-[10px] uppercase tracking-wider text-slate-400 mb-1">Prioridad de Prueba (Vector de Pesos W)</label>
                <select id="mission-mode" class="bg-slate-900 border border-slate-700 text-sm rounded-lg px-3 py-2 text-white focus:outline-none focus:border-sky-500">
                    <option value="balanced">Equilibrado (Base Permanente — 20% c/u)</option>
                    <option value="mobility">Movilidad y Navegación de Rovers (Topo 40% / Ilum 25%)</option>
                    <option value="isru">Geología y Extracción ISRU (Mineralogía 50%)</option>
                    <option value="subsurface">Hábitats Subterráneos y Radiación (Subsuelo 45% / Térm 25%)</option>
                </select>
            </div>
        </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-1 p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 max-w-[1600px] w-full mx-auto">

        <!-- Columna Izquierda: Objetivo Espacial & Visor 3D (4 cols) -->
        <section class="lg:col-span-4 glass-panel rounded-2xl p-5 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-3">
                    <span id="planet-badge" class="px-2.5 py-1 text-xs font-semibold rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                        LUNA • ARTEMIS ZONE
                    </span>
                    <span id="target-coords" class="text-xs font-mono text-slate-400">89.9° S, 0.0° E</span>
                </div>
                
                <h2 id="target-title" class="text-xl font-bold text-white mb-2">Cráter Shackleton</h2>
                <p id="target-desc" class="text-sm text-slate-300 leading-relaxed mb-4">
                    Región de luz eterna en los bordes y sombra permanente (PSR) en el interior con altas reservas de hielo de agua y pendientes pronunciadas.
                </p>

                <!-- Visor Topográfico 3D con Three.js -->
                <div class="mb-4 relative border border-slate-700 rounded-xl overflow-hidden shadow-inner">
                    <div id="canvas-3d-container"></div>
                    <div class="topo-grid absolute inset-0 pointer-events-none"></div>
                    <div class="absolute bottom-2 left-2 right-2 z-10 bg-slate-950/80 backdrop-blur-md px-3 py-1.5 rounded-lg border border-slate-700/80 flex justify-between items-center text-[10px]">
                        <div>
                            <span class="text-slate-400 uppercase block">Modelo 3D Malla Digital</span>
                            <span id="target-dataset" class="font-mono text-sky-300">LRO LOLA + M3 + Diviner</span>
                        </div>
                        <div class="text-right">
                            <span class="text-slate-400 uppercase block">Temp. Media</span>
                            <span id="target-temp" class="font-mono text-amber-300">-183 °C</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Telemetría Física Base -->
            <div class="grid grid-cols-3 gap-2 pt-3 border-t border-slate-800 text-center">
                <div class="bg-slate-900/70 p-2.5 rounded-lg">
                    <p class="text-[10px] text-slate-400 uppercase">Pendiente</p>
                    <p id="target-slope" class="text-sm font-bold text-white mt-0.5">18.5°</p>
                </div>
                <div class="bg-slate-900/70 p-2.5 rounded-lg">
                    <p class="text-[10px] text-slate-400 uppercase">Mineralogía</p>
                    <p id="target-mineral" class="text-sm font-bold text-white mt-0.5">Anortosita</p>
                </div>
                <div class="bg-slate-900/70 p-2.5 rounded-lg">
                    <p class="text-[10px] text-slate-400 uppercase">Gravedad</p>
                    <p id="target-gravity" class="text-sm font-bold text-white mt-0.5">1.62 m/s²</p>
                </div>
            </div>
        </section>

        <!-- Columna Central: Motor Matemático + Deslizador Temporal + Botón Mes Óptimo Dinámico + Radar (4 cols) -->
        <section class="lg:col-span-4 glass-panel rounded-2xl p-5 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-1">
                    <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-400">Índice de Similitud Física</h3>
                    <span id="selected-rank-tag" class="text-xs text-sky-400 font-mono bg-sky-500/10 px-2 py-0.5 rounded border border-sky-500/20">
                        Candidato #1 Global
                    </span>
                </div>

                <!-- Score Principal Calculado en Tiempo Real -->
                <div class="flex items-baseline justify-between mb-2.5">
                    <div class="flex items-baseline gap-2">
                        <span id="match-score" class="text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-sky-400">
                            91.5%
                        </span>
                        <span id="score-month-label" class="text-[11px] text-sky-300 font-medium">en Julio</span>
                    </div>
                    <span id="formula-breakdown" class="text-[10px] font-mono text-emerald-400 bg-emerald-950/50 border border-emerald-500/30 px-2 py-0.5 rounded">
                        Prox: 90.1% | Cos: 99.4%
                    </span>
                </div>

                <!-- Deslizador de Análisis Temporal + Botón Dinámico de Mes Óptimo (PASO 4) -->
                <div class="bg-slate-900/90 border border-sky-500/30 rounded-xl p-3 mb-2.5 shadow-inner">
                    <div class="flex items-center justify-between mb-1.5">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-sky-400 flex items-center gap-1">
                            🗓️ Análisis Temporal (Enero – Diciembre)
                        </span>
                        <span id="current-month-badge" class="text-xs font-extrabold text-white bg-sky-600/40 border border-sky-400/40 px-2 py-0.5 rounded">
                            JULIO
                        </span>
                    </div>

                    <!-- Input Range 0 (Enero) a 11 (Diciembre) -->
                    <input id="month-slider" type="range" min="0" max="11" value="6" class="month-slider my-1.5" />

                    <!-- Etiquetas clickeables de los 12 meses -->
                    <div id="month-ticks-container" class="grid grid-cols-12 text-[9px] font-mono text-slate-400 text-center select-none mt-1">
                        <!-- Se llena dinámicamente ENE..DIC -->
                    </div>

                    <!-- Botón Interactivo de Mes Óptimo Calculado Dinámicamente (Sin rangos fijos) -->
                    <div class="mt-2.5 pt-2.5 border-t border-slate-800 flex flex-col gap-1.5">
                        <div class="flex items-center justify-between text-[11px]">
                            <span id="seasonal-status-badge" class="font-semibold text-emerald-300 truncate">
                                🟢 Pico Estacional de Similitud
                            </span>
                            <span id="candidate-peak-month-label" class="text-[10px] font-mono text-slate-400">
                                Pico sitio: Julio
                            </span>
                        </div>
                        <button id="optimal-month-btn" type="button" onclick="goToOptimalMonth()" class="w-full py-1.5 px-3 rounded-lg bg-gradient-to-r from-emerald-600/30 to-sky-600/30 hover:from-emerald-500/40 hover:to-sky-500/40 border border-emerald-400/50 text-emerald-200 font-semibold text-xs flex items-center justify-center gap-1.5 transition shadow-sm">
                            <span>⚡</span>
                            <span id="optimal-month-btn-text">Ver mes óptimo: Julio (93.8% de similitud)</span>
                        </button>
                    </div>
                </div>

                <!-- Panel Visual de Pesos Matemáticos Activos (W_i) -->
                <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-2 mb-2.5">
                    <div class="flex items-center justify-between text-[10px] text-slate-400 uppercase tracking-wider mb-1">
                        <span>Ponderación Matemática Activa (∑ Wᵢ = 100%)</span>
                        <span id="mode-label-short" class="text-sky-400 font-semibold">Equilibrado</span>
                    </div>
                    <div id="weights-bars-container" class="grid grid-cols-5 gap-1.5 text-center">
                        <!-- Se llena dinámicamente con los 5 pesos de la fórmula -->
                    </div>
                </div>

                <!-- Gráfico de Radar -->
                <div class="bg-slate-900/60 rounded-xl p-2 border border-slate-800 mb-2.5">
                    <canvas id="radarChart" height="165"></canvas>
                </div>
            </div>

            <!-- Alerta de Brecha de Realidad (Reality Gap) + Condición Climática del Mes -->
            <div class="bg-amber-950/30 border border-amber-500/40 rounded-xl p-3">
                <div class="flex items-center justify-between mb-1">
                    <div class="flex items-center gap-1.5">
                        <span class="text-amber-400 text-sm">⚠️</span>
                        <h4 class="text-xs font-bold uppercase tracking-wider text-amber-300">Reality Gap & Clima Mensual</h4>
                    </div>
                    <span id="seasonal-penalty-tag" class="text-[10px] font-mono text-amber-200 bg-amber-500/20 px-1.5 py-0.5 rounded">
                        Fidelidad: 100%
                    </span>
                </div>
                <p id="reality-gap-text" class="text-xs text-amber-100/90 leading-relaxed">
                    Excelente análogo topográfico y térmico criogénico, pero la presión atmosférica terrestre (1 atm) exige compensar la convección térmica en pruebas de trajes y rovers.
                </p>
            </div>
        </section>

        <!-- Columna Derecha: Ranking Global Top 3 + Mapa Mundial Sincronizado Multi-Pin + Exportación Dinámica (4 cols) -->
        <section class="lg:col-span-4 glass-panel rounded-2xl p-5 flex flex-col justify-between">
            <div>
                <!-- Encabezado Ranking Top 3 -->
                <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-sky-400">
                        🏆 Ranking Global del Mes (Top 3)
                    </span>
                    <span id="ranking-month-indicator" class="text-[10px] font-mono text-emerald-400">
                        Período: Julio
                    </span>
                </div>

                <!-- Contenedor del Podio Top 3 Interactivo -->
                <div id="top-ranking-list" class="grid grid-cols-3 gap-2 mb-2.5">
                    <!-- Se llena dinámicamente con las 3 tarjetas del podio -->
                </div>

                <!-- Detalle del Sitio Seleccionado -->
                <div class="flex items-center justify-between mb-1 pt-2 border-t border-slate-800/80">
                    <span id="active-analog-badge" class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                        #1 GANADOR DEL MES
                    </span>
                    <span id="earth-coords" class="text-xs font-mono text-slate-400">77.85° S, 166.67° E</span>
                </div>

                <div class="flex items-center justify-between gap-2 mb-1.5">
                    <div>
                        <h2 id="earth-title" class="text-lg font-bold text-white leading-tight">Valles Secos de McMurdo</h2>
                        <p id="earth-location" class="text-xs text-sky-400 font-medium">Tierra de Victoria, Antártida</p>
                    </div>
                    <button type="button" onclick="fitAllCandidatesOnMap()" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-sky-300 border border-sky-500/30 rounded-lg text-[10px] font-semibold transition shrink-0" title="Ver todos los sitios candidatos simultáneamente en el mapa mundial">
                        🌍 Vista Global
                    </button>
                </div>

                <!-- Leyenda Visual de Pines del Mapa según Ranking -->
                <div class="flex items-center justify-between bg-slate-900/80 border border-slate-800 px-2.5 py-1 rounded-lg mb-1.5 text-[10px]">
                    <span class="flex items-center gap-1 text-emerald-300 font-semibold">
                        <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-r from-emerald-400 to-sky-400 inline-block"></span> #1 Ganador
                    </span>
                    <span class="flex items-center gap-1 text-amber-300 font-semibold">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block"></span> #2 Puesto
                    </span>
                    <span class="flex items-center gap-1 text-slate-300 font-semibold">
                        <span class="w-2.5 h-2.5 rounded-full bg-slate-400 inline-block"></span> #3 y #4
                    </span>
                </div>
            </div>

            <!-- Mapa Satelital Interactivo con Todos los Candidatos Simultáneos -->
            <div class="flex-1 my-1 rounded-xl overflow-hidden border border-slate-700 relative">
                <div id="earth-map"></div>
            </div>

            <!-- Datasets Terrestres Cruzados & Exportación Sincronizada con el Mes -->
            <div class="mt-2.5 pt-2.5 border-t border-slate-800 flex items-center justify-between gap-2 text-xs">
                <div class="truncate">
                    <span class="text-slate-400 block text-[10px] uppercase">Capas NASA / Abiertas</span>
                    <span id="earth-datasets" class="font-mono text-emerald-300 text-[11px]">ASTER GDEM • MODIS LST • SMAP</span>
                </div>
                <div class="flex gap-1.5 shrink-0">
                    <button id="report-btn" onclick="openAnalysisReport()" class="px-3 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-lg transition text-xs shadow-lg shadow-emerald-600/20">
                        📄 Informe de Análisis
                    </button>
                    <button id="export-btn" onclick="exportReport()" class="px-3 py-2 bg-sky-600 hover:bg-sky-500 text-white font-semibold rounded-lg transition text-xs shadow-lg shadow-sky-600/20">
                        📥 JSON (Julio)
                    </button>
                </div>
            </div>
        </section>

    </main>

    <!-- PASO 5: Informe de Análisis Planetario (modal) -->
    <div id="report-overlay" class="hidden fixed inset-0 z-[2000] bg-black/70 backdrop-blur-sm overflow-y-auto p-4">
        <div class="max-w-3xl mx-auto my-4">
            <div class="no-print flex flex-wrap justify-end gap-2 mb-2">
                <button onclick="downloadReportText()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-sky-300 border border-sky-500/30 rounded-lg text-xs font-semibold">⬇ Descargar .txt</button>
                <button id="btn-download-pdf" onclick="downloadReportPDF()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-emerald-300 border border-emerald-500/30 rounded-lg text-xs font-semibold">⬇ Descargar PDF</button>
                <button onclick="closeAnalysisReport()" class="px-3 py-1.5 bg-rose-700 hover:bg-rose-600 text-white rounded-lg text-xs font-semibold">✕ Cerrar</button>
            </div>
